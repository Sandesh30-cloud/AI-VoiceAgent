# --- VideoSDK (required for SIP / playground) ---
VIDEOSDK_AUTH_TOKEN=

# --- Agent identity ---
AGENT_ID=sandesh-missed-call-receptionist
OWNER_NAME=Sandesh
WORKER_HOST=0.0.0.0
WORKER_PORT=8081
MAX_PROCESSES=10

# --- Pipeline: cascade (default) or realtime ---
PIPELINE_MODE=cascade

# Cascade providers (defaults). Do not pass these as code kwargs; plugins read env.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# VideoSDK DeepgramSTT takes a single language string (e.g. en, hi, en-US).
# nova-3 may accept "multi"; that is a Deepgram feature, not documented as auto-detect in VideoSDK.
DEEPGRAM_LANGUAGE=en
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=

# Optional fallbacks (FallbackLLM / FallbackSTT / FallbackTTS)
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
GOOGLE_API_KEY=

# Realtime mode (only if PIPELINE_MODE=realtime)
GEMINI_REALTIME_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Leda

# --- Session ---
WAKE_UP_SECONDS=12
SILENCE_REPROMPT_LIMIT=1
PLAYGROUND=false

# --- Storage / webhooks ---
SQLITE_PATH=./data/calls.db
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
WEBHOOK_SECRET=

# --- Notifications: telegram | whatsapp | both ---
NOTIFY_CHANNEL=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=

# --- Estimated cost rates (USD). Tune to your contracts. ---
COST_LLM_INPUT_PER_MILLION=3.00
COST_LLM_OUTPUT_PER_MILLION=15.00
COST_STT_PER_MINUTE=0.0043
COST_TTS_PER_1K_CHARS=0.15

# --- Logging ---
LOG_LEVEL=INFO
